# Genome data must never enter this repo. Fixtures are synthetic; real exports
# and reports are personal data and stay on the user's disk.
*.txt
*.csv
*.vcf
*.vcf.gz
*.zip
*.html
!docs/index.html
!fixtures/*.txt
!fixtures/*.csv
!fixtures/*.vcf

# Downloaded reference databases (ClinVar, GWAS Catalog) and generated reports
data/
reports/
*.sqlite
*.db

# htslib writes the tabix index for a remote VCF into the working directory, so
# a gnomAD update run from a checkout leaves these behind.
*.tbi
*.bgz
*.bai

.venv/
__pycache__/
*.pyc
.pytest_cache/

# Web bundle is generated but committed so GitHub Pages can serve it.
!docs/db/*.json

# Build artifacts
*.egg-info/
build/
dist/
